APP_URL=http://localhost:3000
WEB_PORT=3000
AUTH_BASE_URL=http://localhost:4000
PORT=4000

INTERNAL_FRONTEND_URL=http://localhost:3000
INTERNAL_BACKEND_URL=http://localhost:4000

TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4000
DEV_USE_INTERNAL_BACKEND_URL_IN_FRONTEND=true

DATABASE_HOST=localhost
DATABASE_PORT=5431
DATABASE_USER=admin
DATABASE_PASSWORD=admin
DATABASE_NAME=media-manager-dev
# Optional alternative to the connection fields above. Do not set an empty URL.
# DATABASE_URL=postgresql://admin:admin@localhost:5431/media-manager-dev
# Use verify for hosted PostgreSQL; disable is for the local development DB.
DATABASE_SSL=disable

BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
MEDIA_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret

INITIAL_USER_EMAIL=admin@example.com
INITIAL_USER_NAME=media-admin
INITIAL_USER_PASSWORD=

# Comma-separated absolute or workspace-relative paths to local scraper plugins.
MEDIA_PLUGIN_PATHS=

# Optional provider env fallbacks. Stored provider secrets still override these.
TMDB_API_KEY=
OMDB_API_KEY=
MDBLIST_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CLIENT_REDIRECT_URI=http://127.0.0.1:4000/api/v1/spotify/callback
DISCOGS_TOKEN=
MB_APP_NAME=
MB_APP_VERSION=
MB_CONTACT=
LASTFM_USERNAME=
LASTFM_API_KEY=
SERPLY_API_KEY=

# Legacy import source directories.
SCAN_DIR=
SCAN_EXCLUDE=
LEGACY_SERVER_DATA_DIR=apps/server/data

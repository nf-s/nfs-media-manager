{
  "name": "@repo/media-plugin-sdk",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./local-worker": {
      "types": "./dist/local-worker.d.ts",
      "import": "./dist/local-worker.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test:unit": "pnpm build && node --test tests/*.test.mjs",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "typescript": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}

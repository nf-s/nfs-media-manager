{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./globals.css": "./src/globals.css",
    "./design-system/*": "./src/design-system/*",
    "./tailwind.config": "./tailwind.config.ts",
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*"
    }
  },
  "scripts": {
    "ui": "pnpm dlx shadcn@latest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:styles": "node scripts/check-styles.mjs",
    "audit:tables": "node scripts/audit-tables.mjs",
    "check:design": "node --test scripts/design-checks.test.mjs && node scripts/check-styles.mjs && node scripts/audit-tables.mjs"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.12",
    "@repo/schemas": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "sonner": "^2.0.0",
    "tailwind-merge": "^2.3.0"
  }
}

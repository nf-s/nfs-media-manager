{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "next build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "check:cloudflare": "node scripts/check-cloudflare-build.mjs",
    "deploy:cloudflare": "pnpm build:cloudflare && node scripts/deploy-cloudflare.mjs",
    "preview:cloudflare": "pnpm build:cloudflare && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.14",
    "@repo/schemas": "workspace:*",
    "@repo/server": "workspace:*",
    "@repo/ui": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.66.7",
    "better-auth": "catalog:",
    "dotenv": "^17.4.0",
    "hono": "catalog:",
    "lucide-react": "catalog:",
    "next": "15.5.28",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.1.7",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/eslint": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "autoprefixer": "catalog:",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wrangler": "4.156.0"
  }
}
